{"lines":["","@Component({","\tselector: \"app-exercise-expanded\",","\tstandalone: true,","\tchangeDetection: ChangeDetectionStrategy.OnPush,","\timports: [DrumPickerComponent, FormsModule, TranslateModule, DecimalInputDirective, ConfirmDialogComponent, ToastComponent],","\ttemplateUrl: \"./exercise-expanded.component.html\",","\tstyleUrl: \"./exercise-expanded.component.scss\",","})","export class ExerciseExpandedComponent {","\tprivate readonly massUnitService = inject(MassUnitService);","\tprivate readonly getPhotoUseCase = inject(GetExercisePhotoUseCase);","\tprivate readonly setPhotoUseCase = inject(SetExercisePhotoUseCase);","\tprivate readonly removePhotoUseCase = inject(RemoveExercisePhotoUseCase);","","\treadonly weightUnit = computed(() => (this.massUnitService.activeMassUnit() === \"metric\" ? \"kg\" : \"lb\"));","","\treadonly exercise = input.required<Exercise>();","\treadonly update = output<Partial<Exercise>>();","\treadonly validate = output<void>();","\treadonly cancel = output<void>();","\treadonly delete = output<void>();","\treadonly openChrono = output<void>();","\treadonly openStats = output<void>();","\treadonly openRating = output<void>();","\treadonly openComment = output<void>();","","\treadonly hasPhoto = computed(() => !!this.getPhotoUseCase.photoFor(this.exercise().name));","\treadonly isNameValid = computed(() => this.exercise().name.trim().length > 0);","","\treadonly showRemoveConfirm = signal(false);","\treadonly toastVisible = signal(false);","\treadonly toastType = signal<ToastType>(\"error\");","","\t@ViewChild(\"fileInput\") fileInputRef!: ElementRef<HTMLInputElement>;"]}