{"lines":["","\treadonly weightValuesForDisplay = computed<(number | string)[]>(() => {","\t\tif (this.massUnitService.activeMassUnit() === \"metric\") return WEIGHT_VALUES;","\t\treturn WEIGHT_VALUES_LB;","\t});","","\treadonly weightSelectedValue = computed<number | string>(() => {","\t\tconst kg = this.exercise().weightKg;","\t\tif (this.massUnitService.activeMassUnit() === \"metric\") return kg;","\t\treturn Math.round(kg * 2.20462);","\t});","","\treadonly setsValues = SETS_VALUES;","\treadonly repsValues = REPS_VALUES;","\treadonly breakValues = BREAK_VALUES;","\treadonly hoursValues = HOURS_VALUES;","\treadonly minutesValues = MINUTES_VALUES;","\treadonly kmValues = KM_VALUES;","\treadonly breakSelectedValue = computed(() => secondsToMmss(this.exercise().breakDurationSeconds));","\treadonly durationHours = computed(() => Math.floor(this.exercise().durationSeconds / 3600));","\treadonly durationMinutes = computed(() => Math.floor((this.exercise().durationSeconds % 3600) / 60));","","\treadonly isPyramidLocal = computed(() => this.exercise().isPyramid ?? false);","\treadonly pyramidSetsLocal = signal<PyramidSet[] | null>(null);","\treadonly effectivePyramidSets = computed(() => this.pyramidSetsLocal() ?? this.exercise().pyramidSets ?? []);","","\ttriggerFilePicker(): void {","\t\tif (this.fileInputRef?.nativeElement) {","\t\t\tthis.fileInputRef.nativeElement.click();","\t\t}","\t}","","\tasync onFileSelected(file: File): Promise<void> {","\t\ttry {","\t\t\tawait this.setPhotoUseCase.execute(this.exercise().name, file);","\t\t} catch {","\t\t\tthis.toastType.set(\"error\");","\t\t\tthis.toastVisible.set(true);","\t\t}","\t}","","\tonFileInputChange(event: Event): void {","\t\tconst input = event.target as HTMLInputElement;","\t\tconst file = input?.files?.[0];","\t\tif (file) {","\t\t\tvoid this.onFileSelected(file);","\t\t}","\t\tif (input) input.value = \"\";","\t}","","\tasync onRemoveConfirmed(): Promise<void> {","\t\tawait this.removePhotoUseCase.execute(this.exercise().name);","\t\tthis.showRemoveConfirm.set(false);","\t}","","\tonToastDismissed(): void {","\t\tthis.toastVisible.set(false);","\t}","","\ttogglePyramid(): void {","\t\tconst next = !this.isPyramidLocal();","\t\tif (next && (this.exercise().pyramidSets ?? []).length === 0) {","\t\t\tconst count = this.exercise().sets;","\t\t\tthis.pyramidSetsLocal.set(","\t\t\t\tArray.from({ length: count }, () => ({ weightKg: this.exercise().weightKg, reps: this.exercise().reps }))","\t\t\t);","\t\t\tthis.update.emit({ isPyramid: true, pyramidSets: this.pyramidSetsLocal()! });","\t\t} else {","\t\t\tthis.pyramidSetsLocal.set(null);","\t\t\tthis.update.emit({ isPyramid: next, pyramidSets: next ? this.exercise().pyramidSets : [] });","\t\t}","\t}","","\taddPyramidSet(): void {","\t\tconst current = this.effectivePyramidSets();","\t\tconst last = current.at(-1);","\t\tconst next = [...current, { weightKg: last?.weightKg ?? 30, reps: last?.reps ?? 10 }];","\t\tthis.pyramidSetsLocal.set(next);","\t\tthis.update.emit({ pyramidSets: next });","\t}","","\tremovePyramidSet(index: number): void {","\t\tconst next = this.effectivePyramidSets().filter((_, i) => i !== index);","\t\tthis.pyramidSetsLocal.set(next);","\t\tthis.update.emit({ pyramidSets: next });","\t}","","\tupdatePyramidSet(index: number, field: \"weightKg\" | \"reps\", value: number): void {","\t\tconst next = this.effectivePyramidSets().map((s, i) => (i === index ? { ...s, [field]: value } : s));","\t\tthis.pyramidSetsLocal.set(next);","\t\tthis.update.emit({ pyramidSets: next });","\t}","","\temitWeightUpdate(value: number | string): void {","\t\tconst displayValue = +value;","\t\tif (this.massUnitService.activeMassUnit() === \"metric\") {","\t\t\tthis.update.emit({ weightKg: displayValue });","\t\t} else {","\t\t\tconst kg = Math.round((displayValue / 2.20462) * 10) / 10;","\t\t\tthis.update.emit({ weightKg: kg });","\t\t}","\t}","","\temitBreakUpdate(v: string | number): void {","\t\tthis.update.emit({ breakDurationSeconds: mmssToSeconds(String(v)) });","\t}","","\temitDurationUpdate(part: \"hours\" | \"minutes\", value: number): void {","\t\tconst current = this.exercise().durationSeconds;","\t\tconst h = Math.floor(current / 3600);","\t\tconst m = Math.floor((current % 3600) / 60);","\t\tconst newSeconds = part === \"hours\" ? value * 3600 + m * 60 : h * 3600 + value * 60;","\t\tthis.update.emit({ durationSeconds: newSeconds });","\t}","","\tonRatingSelected(rating: number | null): void {","\t\tthis.update.emit({ rating });","\t}","}"]}