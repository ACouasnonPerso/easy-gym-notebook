{"lines":["","function secondsToMmss(s: number): string {","\tconst m = Math.floor(s / 60);","\tconst sec = s % 60;","\treturn m.toString().padStart(2, \"0\") + \":\" + sec.toString().padStart(2, \"0\");","}","","function mmssToSeconds(mmss: string): number {","\tconst [m, s] = mmss.split(\":\").map(Number);","\treturn m * 60 + s;","}","","const WEIGHT_VALUES = [...generateRange(0, 30, 0.5), ...generateRange(31, 300, 1)];","const WEIGHT_VALUES_LB = generateRange(10, 500, 1);","const SETS_VALUES = generateRange(1, 20, 1);","const REPS_VALUES = generateRange(1, 50, 1);","const BREAK_VALUES = generateRange(0, 600, 5).map(secondsToMmss);","const HOURS_VALUES = generateRange(0, 12, 1);","const MINUTES_VALUES = generateRange(0, 59, 1);","const KM_VALUES: (number | string)[] = [","\t\"-\",","\t...generateRange(0.1, 2, 0.1).map((v) => Math.round(v * 10) / 10),","\t...generateRange(2.5, 50, 0.5).map((v) => Math.round(v * 10) / 10),","\t...generateRange(51, 200, 1),","];"]}